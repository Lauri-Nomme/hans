# Central lab configuration for the Bitbucket Data Center lab (Phase 0).
# Sourced by lab-up.sh / lab-down.sh. Every value is overridable via env.

# Container runtime. Defaults to `sudo nerdctl` (no passwordless sudo? set
# NERDCTL_CMD="nerdctl" when running as root or with a working runtime).
NERDCTL_CMD="${NERDCTL_CMD:-sudo nerdctl}"

# Image pinned to the exact production version (9.4.18). jdk21 variant.
BB_IMAGE="${BB_IMAGE:-atlassian/bitbucket:9.4.18-jdk21}"
BB_VERSION="9.4.18"

# --- Container A: export side (admin export source, fixture target) ----------
A_NAME="bb-lab-a"
A_HTTP_PORT="${A_HTTP_PORT:-7990}"
A_SSH_PORT="${A_SSH_PORT:-7999}"

# --- Container B: import side (round-trip import target) ---------------------
B_NAME="bb-lab-b"
B_HTTP_PORT="${B_HTTP_PORT:-7991}"
B_SSH_PORT="${B_SSH_PORT:-7998}"

# JVM heap per container (~4 GB each per the plan).
JVM_MIN_MEM="${JVM_MIN_MEM:-4g}"
JVM_MAX_MEM="${JVM_MAX_MEM:-4g}"

# Unattended-setup sysadmin account (bitbucket.properties setup.* keys).
SYSADMIN_USER="${SYSADMIN_USER:-admin}"
SYSADMIN_PASSWORD="${SYSADMIN_PASSWORD:-admin-lab-pw}"
SYSADMIN_DISPLAYNAME="${SYSADMIN_DISPLAYNAME:-Lab Admin}"
SYSADMIN_EMAIL="${SYSADMIN_EMAIL:-admin@lab.example.com}"

# Optional Bitbucket Data Center license. Drop a DC evaluation license into
# this file (from my.atlassian.com) BEFORE the first start so unattended setup
# consumes it. Without it the instance starts unlicensed (see SEED.md).
LAB_LICENSE_FILE="${LAB_LICENSE_FILE:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/license.txt}"

# Max seconds to wait for a container to become ready.
READY_TIMEOUT="${READY_TIMEOUT:-600}"